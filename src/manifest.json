{
  "manifest_version": 3,
  "name": "be-fit",
  "short_name": "be-fit",
  "version": "1.0.0",
  "description": "A free open-source browser extension that reminds everyone staring at a screen to stay fit and drop 20.",
  "homepage_url": "https://github.com/rsinghSD/be-fit-extension",
  "action": {
    "default_title": "be-fit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "background": {
    "service_worker": "background.js"
  }
}
